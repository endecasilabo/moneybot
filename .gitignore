# Ignore everything. The exceptions below are the repo.
*

!.gitignore
!.gcloudignore
!README.md

!.github
!.github/**/
!.github/**/*.yaml
!.github/**/*.yml

!config
!config/**

!app
!app/**
!src
!src/**

!tests
!tests/**

!infra
!infra/**

!dbt
!dbt/**

# Generated and secret, even inside an allowed directory.
.venv/
dbt/target/
dbt/logs/
dbt/dbt_packages/
**/__pycache__/
**/*.pyc
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
.env
