*

# root files
!.gitignore
!readme.md
!makefile

# root directories
!.pre-commit/
!.github/
!services/
!infra/

# pre-commit
!.pre-commit/config.yaml
!.pre-commit/black.toml
!.pre-commit/.sqlfluff

# github
!.github/readme.md
!.github/workflows/
!.github/workflows/*.yml

# services
!services/**/
!services/**/readme.md
!services/**/Dockerfile
!services/**/.dockerignore
!services/**/entrypoint.py
!services/**/requirements.txt
!services/**/src/
!services/**/src/*.py
!services/**/src/**/*.py
!services/**/tests/
!services/**/tests/*.py
!services/**/dbt/
!services/**/dbt/dbt_project.yml
!services/**/dbt/profiles.yml
!services/**/dbt/models/
!services/**/dbt/models/**/*.sql
!services/**/dbt/models/**/*.yml

# infra
!infra/*.tf
!infra/readme.md

