# Ignore everything. The exceptions below are the repo.
*

!.gitignore
!.gcloudignore
!readme.md

!.github/cloudbuild.yml
!.github/workflows/*.yml

!config/*.yml

!app/Dockerfile
!app/entrypoint.py
!app/requirements.txt
!app/.dockerignore

!src/*.py
!tests/*.py
!infra/*.tf

!dbt/dbt_project.yml
!dbt/profiles.yml
!dbt/models/*.sql
!dbt/models/*.yml
!dbt/macros/*.sql
