# Ignore everything. Re-include the directory before the files inside it.
*

!.gitignore
!.gcloudignore
!readme.md

!.github/cloudbuild.yml
!.github/workflows/
!.github/workflows/*.yml

!config/*.yml

!app/Dockerfile
!app/.dockerignore
!app/entrypoint.py
!app/requirements.txt

!src/*.py

!tests/*.py

!infra/*.tf


!dbt/dbt_project.yml
!dbt/profiles.yml
!dbt/requirements.txt
!dbt/models/*.sql
!dbt/models/*.yml
!dbt/macros/*.sql
