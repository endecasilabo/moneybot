# Ignore everything. Re-include the directory before the files inside it.
*

!.gitignore
!.gcloudignore
!readme.md

!.github/
!.github/cloudbuild.yml
!.github/workflows/
!.github/workflows/*.yml
!.github/scripts/
!.github/scripts/*.py

!config/
!config/*.yml

!services/
!services/**/
!services/**/*.py
!services/**/*.txt
!services/**/*.toml
!services/**/*.yml
!services/**/Dockerfile
!services/**/.dockerignore

!infra/
!infra/*.tf

!dbt/
!dbt/dbt_project.yml
!dbt/profiles.yml
!dbt/requirements.txt
!dbt/models/
!dbt/models/*.sql
!dbt/models/*.yml
!dbt/models/base/
!dbt/models/base/*.yml
!dbt/models/base/*.sql
!dbt/macros/
!dbt/macros/*.sql

!requirements-dev.txt

!brain/
!brain/**
